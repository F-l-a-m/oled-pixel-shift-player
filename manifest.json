{
  "manifest_version": 3,
  "name": "OLED Pixel Shift Player",
  "version": "0.1.0",
  "description": "Reduce OLED burn-in by slowly and continuously shifting HTML5 video position and scale in fullscreen.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}